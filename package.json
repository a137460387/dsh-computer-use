{
  "name": "dsh-computer-use",
  "version": "0.1.3",
  "description": "Desktop-level Computer Use (vision control) bundle for DeepSeek Harness: screenshots, clicks, typing, scrolling, and hotkeys driven by a vision model over a Python MCP sidecar.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src",
    "src-python",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:python": "python scripts/build-python.py",
    "test": "vitest run",
    "dev": "python src-python/main.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "//": "Development-time resolution only: pnpm applies these overrides solely when this repository is the root project. They link the harness packages to the sibling source checkout because the npm-published versions predate the harness this fork runs. Consumer installs resolve peers through the dsh module fallback instead.",
    "overrides": {
      "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
      "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
      "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
      "@deepseek-ai/dsh-attachment": "link:../deepseek-harness/packages/attachment/attachment",
      "@deepseek-ai/dsh-brand": "link:../deepseek-harness/packages/util/brand",
      "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
      "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
      "@deepseek-ai/dsh-subprocess": "link:../deepseek-harness/packages/subprocess/subprocess",
      "@deepseek-ai/dsh-timeout": "link:../deepseek-harness/packages/util/timeout",
      "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
      "@deepseek-ai/dsh-user-approval": "link:../deepseek-harness/packages/interaction/user-approval",
      "@deepseek-ai/dsh-util-values": "link:../deepseek-harness/packages/util/values"
    }
  }
}
