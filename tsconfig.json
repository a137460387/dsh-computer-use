{
  "//": "Type-check only (noEmit): this fork's source-launch dsh (tsx) loads the .ts entry directly at runtime. A distributable build (transpile + prepare script, per docs/user/develop/basic/publish.md) lands with Phase 3. Compiler strictness mirrors deepseek-harness tsconfig.base.json.",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts"]
}
